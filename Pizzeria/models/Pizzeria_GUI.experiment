/**
* Name: Pizzeria_GUI
* This wizard creates a new experiment file. 
* Author: root
* Tags: 
*/
model Pizzeria_GUI

import "Pizzeria.gaml"
import "Cook.gaml"
import "Machine.gaml"
import "Counter.gaml"

experiment "Pizzeria_GUI"  type:gui {
	
	parameter "Nb customers" var: nb_customers   min: 1  max: 50  init: 10  category: "Customers";
    parameter "Number of tables" var: nb_tables min: 1 max: 20 init: 5 category: "Customers";
    parameter "Spawn rate (cycles)"   var: spawn_every    min: 1  max: 20  init: 5   category: "Customers";
    parameter "Arrival Rate (λ)"      var: lambda_arrival min: 0.1 max: 5.0 init: 1.5 category: "Customers";

    parameter "Nb cooks"              var: nb_cooks       min: 1  max: 10  init: 2   category: "Staff";

    parameter "Nb machines"           var: nb_machines    min: 1  max: 10  init: 4   category: "Kitchen";
    parameter "Min task (cycles)"     var: min_task_time  min: 2  max: 10  init: 5   category: "Kitchen";
    parameter "Max task (cycles)"     var: max_task_time  min: 8  max: 25  init: 15  category: "Kitchen";

    output {
        monitor "CA Actuel"              value: restaurant_ca refresh: every(5 #cycle);
        monitor "Période"                value: traffic_period color: #white;
        monitor "Taux Satisfaction (%)"  value: (served_customers + unsatisfied_customers > 0) ? (float(served_customers) / (served_customers + unsatisfied_customers)) * 100 : 100.0 refresh: every(20 #cycle);
        monitor "Clients Perdus"         value: unsatisfied_customers refresh: every(20 #cycle);
        monitor "Total Clients Entrés"   value: total_customers_entered refresh: every(5 #cycle);
        monitor "Wait Time (avg)"        value: avg_wait_time refresh: every(50 #cycle);
        monitor "Utilisation Machines (%)" value: (length(Machine where (each.is_occupied)) / length(Machine)) * 100;
        monitor "Chance Entrée (Actuelle)" value: (1 - exp(-lambda_arrival)) * 100;
        monitor "Flux (Lambda actuel)"   value: lambda_arrival;
        monitor "Chance Entrée (%)"      value: (1 - exp(-lambda_arrival)) * 100;
        monitor "Occupation Salles (%)"   value: (Table sum_of (each.occupied_seats)) / (Table sum_of (each.max_capacity)) * 100;
        monitor "% CA (derniers 1000 pas)" value: revenue_velocity_pct;
        monitor "Productivité Staff (%)"  value: (length(Cook where (each.state in ["working", "going_to_machine", "going_to_counter"])) / length(Cook)) * 100;

        display Charts {
            chart "CA restaurant" type: series {
                data "Revenue (CHF)" value: restaurant_ca color: #green;
            }
        }
    
        display main type: 2d background: #whitesmoke {

            graphics "background" {
                draw rectangle(width, height) at: {width/2, height/2}
                   color: #blue border: #yellow;
                    
                // Sidewalk
                draw sidewalk color: #red border: #gray;
                // Kitchen
                draw kitchen color: #pink;
                // Dining_area
                draw dining_area color: #orange;
                // Entrance
                draw entrance color: #green;
                
                draw waiting_area color: #purple;
            }

            species Table aspect: base;
            species Machine aspect: base;
            species Counter aspect: base;
            species Cook aspect: base;
            species Customer aspect: base;
        }
    }
}